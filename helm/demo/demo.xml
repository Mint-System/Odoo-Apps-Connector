<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_partner_mint_system_demo" model="res.partner">
        <field name="name">Mint System</field>
    </record>

    <record id="product_odoo_community_edition_demo" model="product.template">
        <field name="name">Odoo Community Edition</field>
        <field name="type">consu</field>
        <field name="list_price">50</field>
    </record>

    <record id="product_odoo_enterprise_edition_demo" model="product.template">
        <field name="name">Odoo Enterprise Edition</field>
        <field name="type">consu</field>
        <field name="list_price">80</field>
    </record>

    <record id="kubernetes_build_demo" model="helm.repo">
        <field name="name">kubernetes-build</field>
        <field name="url">https://kubernetes.build</field>
    </record>

    <record id="odoo_chart_demo" model="helm.chart">
        <field name="name">odoo</field>
        <field name="repo_id" ref="helm.kubernetes_build_demo" />
        <field
            name="product_ids"
            eval="[(4, ref('helm.product_odoo_community_edition_demo')), (4, ref('helm.product_odoo_enterprise_edition_demo'))]"
        />
    </record>

    <record id="odoo_release_demo" model="helm.release">
        <field name="name">odoo</field>
        <field name="chart_id" ref="helm.odoo_chart_demo" />
        <field name="context_id" ref="kubectl.kubectl_context_kind_demo" />
        <field name="partner_id" ref="helm.res_partner_mint_system_demo" />
    </record>
</odoo>
