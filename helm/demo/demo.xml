<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_partner_mint_system_demo" model="res.partner">
        <field name="name">Mint System</field>
    </record>

    <record id="odoo_chart_demo" model="helm.chart">
        <field name="name">odoo</field>
        <field name="repo_id" ref="helm.kubernetes_build_demo" />
        <!-- <field
            name="product_ids"
            eval="[(4, ref('helm.product_odoo_community_edition_demo')), (4, ref('helm.product_odoo_enterprise_edition_demo'))]"
        /> -->
    </record>

    <record id="product_odoo_community_edition_demo" model="product.product">
        <field name="name">Odoo Community Edition</field>
        <field name="type">consu</field>
        <field name="list_price">50</field>
        <field name="chart_ids" eval="[(4, ref('helm.odoo_chart_demo'))]" />
    </record>

    <record id="product_odoo_enterprise_edition_demo" model="product.product">
        <field name="name">Odoo Enterprise Edition</field>
        <field name="type">consu</field>
        <field name="list_price">80</field>
        <field name="chart_ids" eval="[(4, ref('helm.odoo_chart_demo'))]" />
    </record>

    <record id="kubernetes_build_demo" model="helm.repo">
        <field name="name">kubernetes-build</field>
        <field name="url">https://kubernetes.build</field>
    </record>

    <record id="odoo_chart_value_ingress_host_demo" model="helm.chart.edit">
        <field name="chart_id" ref="helm.odoo_chart_demo" />
        <field name="path">ingress.host</field>
        <field
            name="code"
        >release.namespace_id.name + '.' + release.context_id.cluster_id.domain</field>
        <field name="field_id" ref="helm.field_helm_release__ingress_host" />
    </record>

    <record id="odoo_chart_value_ingress_secure_demo" model="helm.chart.edit">
        <field name="chart_id" ref="helm.odoo_chart_demo" />
        <field name="path">ingress.secure</field>
        <field
            name="code"
        >True if release.context_id.cluster_id.code in ['exo'] else False</field>
    </record>

    <record id="odoo_chart_value_vshnpostgres_enabled_demo" model="helm.chart.edit">
        <field name="chart_id" ref="helm.odoo_chart_demo" />
        <field name="path">vshnPostgres.enabled</field>
        <field
            name="code"
        >True if release.context_id.cluster_id.code in ['exo'] else False</field>
    </record>

    <record id="odoo_chart_value_postgres_enabled_demo" model="helm.chart.edit">
        <field name="chart_id" ref="helm.odoo_chart_demo" />
        <field name="path">postgres.enabled</field>
        <field
            name="code"
        >False if release.context_id.cluster_id.code in ['exo'] else True</field>
    </record>

    <record id="odoo_release_demo" model="helm.release">
        <field name="name">odoo</field>
        <field name="chart_id" ref="helm.odoo_chart_demo" />
        <field name="context_id" ref="kubectl.kubectl_context_kind_demo" />
        <field name="namespace_id" ref="kubectl.kubectl_namespace_odoo_demo" />
        <field name="partner_id" ref="helm.res_partner_mint_system_demo" />
        <field name="ingress_scheme">http://</field>
        <field name="ingress_port">8080</field>
    </record>
</odoo>
